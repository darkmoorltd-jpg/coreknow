{
  "expo": {
    "name": "CoreKnow",
    "slug": "coreknow",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "coreknow",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.darkmoor.coreknow"
    },
    "android": {
      "package": "com.darkmoor.coreknow",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05050a"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://coreknow.onrender.com"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#05050a"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}